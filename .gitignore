/p[0-9]*.jpg
/p[0-9]*.png
/page[0-9]*-debug*.jpg
/page[0-9]*-debug*.png

# Local scratchpad — analysis scripts, dump files, ad-hoc PDFs
tmp/

# Manual test artifacts (screenshots etc. dumped during testing)
tests/manual/*.png
tests/manual/*.jpg

# Temp photos (debug/testing)
temp_photos/

# Test fixtures (large test data)
tests/fixtures/
test image inputs/

# Baden landmarks cache (local testing)
baden-landmarks/

# Output folder (story extractions, etc.)
output/

# Historical location images (local editing)
historical-location-images/
historical-location-images-uploaded/

