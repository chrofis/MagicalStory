    { "key": "olderSiblingOf", "sentence": "{A} is the older sibling of {B}", "inverse": "youngerSiblingOf", "labels": { "en": "Older Sibling of", "de": "Älteres Geschwister von", "fr": "Frère/Sœur aîné(e) de", "it": "Fratello/Sorella maggiore di" } },
