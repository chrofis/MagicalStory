{
 "version": 1,
 "date": "2026-10-10",
 "labellingRule": {
  "text": "Labelled by viewing the pixels (2026-10-10) BEFORE any judge ran. A sheet = 4 head cells over 4 body cells. hat: headgear is missing in some cells, differs in shape/colour between cells, is deformed/towering, or appears on an everyday sheet where the photo shows none (a costume hat worn identically in all 8 cells is NOT a defect). hair: colour, length or style differs between cells (hair down in one cell, ponytail in another) or from the photo. bald: any cell with a smooth hairless scalp where other cells show hair, or a missing/blank head. costume: garments, colours or chest emblems differ between cells. rowMatch: a head cell shows a different top/collar/straps than its full-body twin. held: any held or carried object. layout: not a 2x4 grid, extra people, lettering on the paper, or photographic/cut-out rather than painted cells. identity: clearly another person/gender than the photo. age: apparent age more than 3 years off. Sheets whose label is genuinely unclear are marked ambiguous and excluded from every metric.",
  "types": [
   "hat",
   "hair",
   "bald",
   "costume",
   "rowMatch",
   "held",
   "layout",
   "identity",
   "age"
  ]
 },
