#!/bin/sh
# Refuse to push while the target environment has work in flight — a redeploy
# restarts the container and kills in-process story generations and Test Lab
# experiments. See scripts/admin/check-push-idle.js for the reasoning.
#
# Enabled automatically by `npm install` (scripts/admin/setup-git-hooks.js),
# which sets core.hooksPath to this directory's ABSOLUTE path. That matters:
# a relative hooksPath is resolved per working tree, so an agent worktree on a
# branch older than this file has no hook at all — and git skips a missing hook
# silently. Bypass a single push with: git push --no-verify
#
# Resolved relative to THIS FILE, not `git rev-parse --show-toplevel`: when a
# worktree is on an old branch, the toplevel has no scripts/admin/ yet, but this
# hook always sits next to the main clone's copy.
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Gate 1: settled-verdict guard (docs/SETTLED.md) — refuses pushes that
# reintroduce deliberately-removed patterns (dark text zones, hats rules,
# test-story names in prompts, eszett in German strings).
node "$HOOK_DIR/../scripts/admin/check-settled.js" || exit 1

# Gate 2: crash guard — no undefined variables in the server code being pushed.
# Three ReferenceErrors shipped in one day (manual character repair, cover
# iterate, and the Pass-2 style transfer, which lost every story's art-style
# conversion). All three were wrapped in try/catch, so they surfaced as
# plausible degraded output instead of an error. ~1s, committed content only.
node "$HOOK_DIR/../scripts/admin/check-no-undef.js" || exit 1

# Gate 3: documentation that asserts a code value must still be true.
# 2026-08-17: figureDetectionBackend flipped to grounding-dino and FIVE documents
# kept saying "prod stays gemini" — including one that implied a feature always
# aborts in production, which had stopped being true. Prose cannot be diffed
# against code, so the claims that matter carry <!-- ASSERT ... --> markers.
node "$HOOK_DIR/../scripts/admin/check-doc-drift.js" || exit 1

# Gate 4: a push that changes behaviour must touch a doc. The companion to
# gate 3: that one catches a claim gone stale, this one catches the change
# nobody wrote down at all. Narrow on purpose — a gate that cries wolf gets
# bypassed, and a bypassed gate is worse than none.
node "$HOOK_DIR/../scripts/admin/check-doc-coupling.js" || exit 1

# Gate 4b: a push that changes behaviour says how a story run will prove it
# (owner, 2026-09-24: "we do 20 changes that need a new story ... we should
# ensure if all 20 are tested or not"). Same WATCHED files as gate 4. The push
# adds/changes an entry in tasks/verify.json, or each such commit carries
# `Verify: <entry-id>` or `Verify: none (<reason>)`. Commits older than this
# gate are never judged. After a run: node scripts/admin/verify-run.js <storyId> --write
node "$HOOK_DIR/../scripts/admin/check-verify-coupling.js" || exit 1

# Gate 5: no OPEN reported bugs (tasks/bugs.json). CLAUDE.md has said "just fix
# it" since the beginning and it kept not happening — clear bugs were backlogged
# while unrelated work shipped over them. While any registry entry is open,
# nothing ships. Emergency escape: PUSH_WITH_OPEN_BUGS=1 (defers, never
# dismisses — the next push is blocked again).
node "$HOOK_DIR/../scripts/admin/check-open-bugs.js" || exit 1

# Gate 6: evalBuckets owns the finding taxonomy; scoring.js owns only cost. A raw
# evaluator TYPE placed in scoring's billing tables never matches (types resolve
# to buckets first) and fails SILENTLY — see check-taxonomy-ownership.js.
node "$HOOK_DIR/../scripts/admin/check-taxonomy-ownership.js" || exit 1

# Gate 6b: the Test Lab must SEND what production sends. repairCharacterFace had
# its options assembled by hand in repairPipeline.js AND testlab.js; they drifted
# in both directions and neither passed artStyle, so every production repair ran
# without its art-style block and no Lab run could reveal it. One contract
# (charRepairRequest.js), and every deliberate Lab deviation indexed in
# docs/lab-divergences.md. See tests/manual/test-char-repair-parity.js.
node "$HOOK_DIR/../tests/manual/test-char-repair-parity.js" >/dev/null || {
  echo ""
  echo "check-lab-parity: the Test Lab and production disagree on the char-repair contract"
  node "$HOOK_DIR/../tests/manual/test-char-repair-parity.js"
  exit 1
}

# Gate 6c: the analyzer's worker lifecycle. Two defects shipped together on
# 2026-09-05 and cost a production 502 on the first photo upload after a deploy:
# the idle reaper killed a worker mid-startup (a warmup brought it up off a
# request, so the reaper's request-epoch guard could not see it), and
# ensure_worker handed out a process that was alive but not yet listening.
# Both live in bookkeeping no story run exercises deterministically, so they get
# a test rather than a hope. ~6s, loads no ML model.
#
# SKIPS (with a warning) when the Python deps are absent: a hook that blocks a
# push because a machine has no cv2 is a hook people disable. Only a real test
# failure is a gate.
if python -c "import cv2" >/dev/null 2>&1; then
  python "$HOOK_DIR/../tests/manual/test_worker_bringup_race.py" >/dev/null 2>&1 || {
    echo ""
    echo "check-worker-lifecycle: the analyzer worker bring-up guarantees are broken"
    python "$HOOK_DIR/../tests/manual/test_worker_bringup_race.py"
    exit 1
  }
else
  echo "check-worker-lifecycle: SKIPPED (no python cv2 on this machine)"
fi

# Gate 7: no Gemini 3.x model on Google's NATIVE api may carry sampling params —
# they are silently ignored there, so a repointed eval call site loses its
# temperature:0 determinism with no error. See check-gemini-sampling.js.
node "$HOOK_DIR/../scripts/admin/check-gemini-sampling.js" || exit 1

# Gate 9: a fix must reach every sibling of the path it fixes. A 2026-09-15
# sweep of 173 behaviour commits from a 60-hour window found 27 partial fixes,
# all the same shape — the change landed on one code or prompt path and not its
# sibling. One of them was the story's root cause: a metadata field added to the
# per-page Art Director template and not to the all-pages one the live pipeline
# runs, so the guard reading it saw false on every page. The sibling sets are
# declared in scripts/admin/sibling-registry.json. Escape, when the sibling
# genuinely needs no change: put `Siblings-Checked: <reason>` in the commit
# message. See docs/sibling-paths.md.
node "$HOOK_DIR/../scripts/admin/check-sibling-paths.js" || exit 1

# Task hygiene (WARNS, never blocks): open work added to a doc should be
# reachable from tasks/BACKLOG.md. A 2026-08-20 sweep found ~184 live open items
# across ~40 files with no index tying them together; this notices a file of open
# work that nobody pointed at. Deliberately not a gate — see the script's header.
node "$HOOK_DIR/../scripts/admin/check-backlog-index.js"

# Gate 8: target environment must be idle (see check-push-idle.js).
exec node "$HOOK_DIR/../scripts/admin/check-push-idle.js" "$@"
